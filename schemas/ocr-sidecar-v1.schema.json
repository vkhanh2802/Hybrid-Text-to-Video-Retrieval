{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kis:ocr-sidecar-v1",
  "title": "Independent OCR JSONL record, canonical key (video_id, keyframe_n)",
  "description": "One envelope per JSONL line. manifest.json repeats schema/schema_version and inventories all canonical keys. Runtime validation also checks unique keys, hashes, transforms, line sorting and status semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "group", "video_id", "keyframe_n", "image_name", "source_path", "image_sha256", "mapping", "engine", "status", "preprocessing", "lines", "error"],
  "properties": {
    "schema": {"const": "ocr-sidecar-v1"},
    "schema_version": {"const": 1},
    "group": {"type": "string", "pattern": "^L[0-9]+$"},
    "video_id": {"type": "string", "pattern": "^L[0-9]+_V[0-9]+$"},
    "keyframe_n": {"type": "integer", "minimum": 0},
    "image_name": {"type": ["string", "null"], "pattern": "^[0-9]+\\.([jJ][pP][eE]?[gG]|[pP][nN][gG])$"},
    "source_path": {"type": ["string", "null"], "minLength": 1},
    "image_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "mapping": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["frame_idx", "timestamp_seconds"],
      "properties": {
        "frame_idx": {"type": "integer", "minimum": 0},
        "timestamp_seconds": {"type": "number", "minimum": 0}
      }
    },
    "engine": {"$ref": "#/$defs/engine"},
    "status": {"enum": ["ok", "empty", "missing", "error", "unknown"]},
    "preprocessing": {"anyOf": [{"$ref": "#/$defs/preprocessing"}, {"type": "null"}]},
    "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {"type": {"type": "string", "minLength": 1}, "code": {"const": "OCR_FAILED"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"properties": {"lines": {"minItems": 1}}}, "else": {"properties": {"lines": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "error"}}}, "then": {"properties": {"error": {"type": "object"}}}, "else": {"properties": {"error": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["ok", "empty"]}}}, "then": {"properties": {"preprocessing": {"type": "object"}, "image_sha256": {"$ref": "#/$defs/sha256"}, "source_path": {"type": "string"}, "image_name": {"type": "string"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "polygon": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "matrix": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "padding": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "top", "right", "bottom", "color"],
      "properties": {
        "left": {"type": "integer", "minimum": 0, "maximum": 4096},
        "top": {"type": "integer", "minimum": 0, "maximum": 4096},
        "right": {"type": "integer", "minimum": 0, "maximum": 4096},
        "bottom": {"type": "integer", "minimum": 0, "maximum": 4096},
        "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
      }
    },
    "preprocessing": {
      "type": "object", "additionalProperties": false,
      "required": ["padding", "original_size", "padded_size", "resize", "forward_transform", "inverse_transform", "coordinate_space"],
      "properties": {
        "padding": {"$ref": "#/$defs/padding"},
        "original_size": {"$ref": "#/$defs/size"},
        "padded_size": {"$ref": "#/$defs/size"},
        "resize": {"type": "null"},
        "forward_transform": {"$ref": "#/$defs/matrix"},
        "inverse_transform": {"$ref": "#/$defs/matrix"},
        "coordinate_space": {"const": "Paddle predict rec_polys mapped back to supplied padded image; not model tensors"}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "versions", "models", "device", "language", "config_sha256"],
      "properties": {
        "name": {"const": "paddleocr"},
        "versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "device": {"enum": ["cpu", "gpu:0"]},
        "language": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "models": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "name", "repo", "revision", "files_sha256"],
            "properties": {
              "role": {"enum": ["detection", "recognition"]},
              "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
              "repo": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "files_sha256": {"type": "object", "required": ["inference.json", "inference.pdiparams", "inference.yml"], "additionalProperties": {"$ref": "#/$defs/sha256"}}
            }
          }
        }
      }
    },
    "line": {
      "type": "object", "additionalProperties": false,
      "required": ["line_index", "text", "confidence", "language", "script", "polygon_padded", "bbox_padded", "polygon_original", "bbox_original", "polygon_original_clipped", "bbox_original_clipped"],
      "properties": {
        "line_index": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "language": {"type": ["string", "null"]},
        "script": {"type": ["string", "null"]},
        "polygon_padded": {"$ref": "#/$defs/polygon"},
        "bbox_padded": {"$ref": "#/$defs/bbox"},
        "polygon_original": {"$ref": "#/$defs/polygon"},
        "bbox_original": {"$ref": "#/$defs/bbox"},
        "polygon_original_clipped": {"$ref": "#/$defs/polygon"},
        "bbox_original_clipped": {"$ref": "#/$defs/bbox"}
      }
    }
  }
}
