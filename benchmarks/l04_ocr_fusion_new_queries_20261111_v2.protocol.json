{
  "execution": "Offline in-memory CPU BM25 only. No network/install/inference/LLM API/Milvus/index rebuild/production edits. Only dataset/{data,caption_generator,mapping,ocr}/L04; never enumerate/read excluded group roots. Unique output directory, final reports frozen.",
  "group": "L04",
  "judgments": {
    "freeze": "Write selected identities, queries, image hashes and judgments into new packet before loading any caption/OCR payload or ranking. Never change packet or weights after results. Record actual packet/protocol/config SHA256 in final manifests.",
    "inspection": "Read all 90 original target/neighborhood images directly through functions.read before authoring freeze; no OCR/caption payload or rank reads.",
    "language": "Natural English scene descriptions. Preserve exact readable Vietnamese/English strings for literal/mixed. Mark English or English+Vietnamese per query. Visual transcription by this assistant, no independent human verification; small compressed broadcast text may be ambiguous. Source image grounding does not prove upstream OCR byte provenance.",
    "record": "Each judgment includes target identity, judged identity, source_image, local image_sha256, label 0/1, rationale. Target must be positive. Uninspected images UNJUDGED, not negatives; qrels incomplete.",
    "relevance": "Binary, whole natural-language query must be visibly supported. For literal/mixed, exact quoted on-screen strings must be readable. Include every inspected relevant neighbor; no automatic temporal/video relevance. Explicit visible differences justify negatives."
  },
