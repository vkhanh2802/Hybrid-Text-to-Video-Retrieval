# Groq environment-variable example; .env files are not loaded automatically.
# start_kis.ps1 reads process env, then Windows User env, then prompts (masked).
# -PromptForKey bypasses stored/process keys for a temporary masked entry.
GROQ_API_KEY=your_groq_api_key
# Default model: openai/gpt-oss-20b
# Query output: json_schema (strict on both attempts), temperature 0.
# Test only the API/JSON contract: .\start_kis.ps1 -CheckApi
# Optional custom trusted CA bundle:
# SSL_CERT_FILE=C:/path/to/company-ca.pem

# Defaults are read from config/pipeline.json by web and notebook.
# Optional overrides:
# KIS_RETRIEVAL_PROFILE=rrf
# Optional independent pixel OCR index; off (default), diagnostics, retrieve.
# KIS_OCR_MODE=off
# KIS_OCR_INDEX=dataset/ocr/index.sqlite3
# Optional CPU text reranker; off (default), diagnostics, or rerank.
# Requires the pinned model already in the local Hugging Face cache; no auto-download.
# KIS_TEXT_RERANKER_MODE=off
# KIS_VIDEO_GROUPS=L01,L02,L03,L07,L08,L09,L10,L11,L12,L13,L14,L15,L16,L17,L18,L19,L20,L21
# KIS_CAPTION_ROOT=dataset
# KIS_DATA_ROOT=G:/My Drive/KIS/data
# Optional machine-local reader (kis/local_images.py is gitignored):
# KIS_DRIVE_FOLDER_ID=folder_id_containing_L15_L16_and_other_groups
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/drive-readonly.local.json

# DRES v2: only non-secret server target/run settings. Enter credentials in the UI.
# Can also use config/dres.local.json (gitignored): base_url, evaluation_id.
# KIS_DRES_BASE_URL=https://aiclub.uit.edu.vn/dres
# KIS_DRES_RUN_ID=your-evaluation-run-uuid
# Do not store DRES passwords/session IDs here or in source code.
